{
  "manifest_version": 3,
  "name": "TypeRacer Stats Overlay",
  "version": "2.0.1",
  "description": "Live overlay for TypeRacer with last 10 races history, daily streak progress, QOTD timer, 1h notification, and quote performance comparison.",
  "permissions": [
    "storage",
    "alarms",
    "notifications"
  ],
  "host_permissions": [
    "https://play.typeracer.com/*",
    "https://data.typeracer.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://play.typeracer.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_end"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
