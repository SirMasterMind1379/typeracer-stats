{
  "manifest_version": 3,
  "name": "TypeRacer Stats Overlay",
  "version": "2.2.1",
  "description": "Live overlay for TypeRacer with last 10 races history, daily streak progress, QOTD timer, 1h notification, and quote performance comparison.",
  "permissions": [
    "storage",
    "alarms",
    "notifications"
  ],
  "host_permissions": [
    "https://*.typeracer.com/*",
    "https://typeracer.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.typeracer.com/*",
        "https://typeracer.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_icon": {
      "16": "icons/icon16.jpg",
      "48": "icons/icon48.jpg",
      "128": "icons/icon128.jpg"
    },
    "default_title": "TypeRacer Stats Overlay"
  },
  "icons": {
    "16": "icons/icon16.jpg",
    "48": "icons/icon48.jpg",
    "128": "icons/icon128.jpg"
  }
}
